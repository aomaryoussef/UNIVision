{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/(home|grades|attendance|comparison|reports|schedule|work|simulator|materials|profile)\\.html", "dest": "api/index.js" },
    { "src": "/doctor\\.html", "dest": "api/index.js" },
    { "src": "/login", "dest": "api/index.js" },
    { "src": "/landing\\.html", "dest": "api/index.js" },
    { "src": "/manifest\\.json", "dest": "client/manifest.json" },
    { "src": "/sw\\.js", "dest": "client/sw.js" },
    { "src": "/assets/(.*)", "dest": "client/assets/$1" },
    { "src": "/css/(.*)", "dest": "client/css/$1" },
    { "src": "/js/(.*)", "dest": "client/js/$1" },
    { "src": "/pages/(.*)", "dest": "client/pages/$1" },
    { "src": "/(.*\\.(html|ico|png|jpg|svg|webp))", "dest": "client/$1" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
